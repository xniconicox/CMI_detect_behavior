      "source": [
       "# 外れ値の時系列分析（最も外れ値の多いセンサー）\n",
       "if outlier_results and windows is not None:\n",
       "    # 最も外れ値の多いセンサーを特定\n",
       "    worst_sensor = max(outlier_results.items(), key=lambda x: x[1]['outlier_count'])\n",
       "    worst_sensor_name = worst_sensor[0]\n",
       "    worst_sensor_idx = sensor_names.index(worst_sensor_name)\n",
       "    \n",
       "    print(f\"🔍 最も外れ値の多いセンサー: {worst_sensor_name}\")\n",
       "    print(f\"外れ値数: {worst_sensor[1]['outlier_count']:,}個 ({worst_sensor[1]['outlier_ratio']:.2f}%)\")\n",
       "    \n",
       "    # 外れ値の時系列分布を分析\n",
       "    sensor_data = windows[:, :, worst_sensor_idx]\n",
       "    \n",
       "    # 各ウィンドウでの外れ値数を計算\n",
       "    window_outlier_counts = []\n",
       "    for i in range(sensor_data.shape[0]):\n",
       "        window_data = sensor_data[i, :]\n",
       "        z_scores = np.abs((window_data - window_data.mean()) / window_data.std())\n",
       "        outlier_count = (z_scores > 3.0).sum()\n",
       "        window_outlier_counts.append(outlier_count)\n",
       "    \n",
       "    # 可視化\n",
       "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(15, 10))\n",
       "    \n",
       "    # ウィンドウ別外れ値数\n",
       "    ax1.plot(window_outlier_counts[:100], alpha=0.7)  # 最初の100ウィンドウ\n",
       "    ax1.set_title(f'{worst_sensor_name} - ウィンドウ別外れ値数（最初の100ウィンドウ）')\n",
       "    ax1.set_xlabel('ウィンドウ番号')\n",
       "    ax1.set_ylabel('外れ値数')\n",
       "    ax1.grid(True, alpha=0.3)\n",
       "    \n",
       "    # 外れ値数の分布\n",
       "    ax2.hist(window_outlier_counts, bins=30, alpha=0.7, color='red')\n",
       "    ax2.set_title(f'{worst_sensor_name} - ウィンドウ別外れ値数の分布')\n",
       "    ax2.set_xlabel('ウィンドウ内の外れ値数')\n",
       "    ax2.set_ylabel('ウィンドウ数')\n",
       "    ax2.grid(True, alpha=0.3)\n",
       "    \n",
       "    plt.tight_layout()\n",
       "    plt.show()\n",
       "    \n",
       "    # 統計情報\n",
       "    print(f\"\\n📊 ウィンドウ別外れ値統計:\")\n",
       "    print(f\"平均外れ値数/ウィンドウ: {np.mean(window_outlier_counts):.2f}\")\n",
       "    print(f\"最大外れ値数/ウィンドウ: {np.max(window_outlier_counts)}\")\n",
       "    print(f\"外れ値なしウィンドウ数: {(np.array(window_outlier_counts) == 0).sum()}\")\n",
       "    print(f\"外れ値ありウィンドウ数: {(np.array(window_outlier_counts) > 0).sum()}\")"
      ]
