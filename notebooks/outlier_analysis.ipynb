{
    "cells": [
     {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
       "# センサーデータ外れ値分析\n",
       "\n",
       "このノートブックでは、センサーデータの外れ値を詳細に分析します。"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "import numpy as np\n",
       "import pandas as pd\n",
       "import matplotlib.pyplot as plt\n",
       "import seaborn as sns\n",
       "import pickle\n",
       "from pathlib import Path\n",
       "import warnings\n",
       "warnings.filterwarnings('ignore')\n",
       "\n",
       "# 日本語フォント設定\n",
       "plt.rcParams['font.family'] = 'DejaVu Sans'\n",
       "plt.rcParams['axes.unicode_minus'] = False\n",
       "\n",
       "print(\"ライブラリ読み込み完了\")"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# 実験設定\n",
       "EXPERIMENT_NAME = \"preprocess_v2_ws64\"  # または \"preprocess_v2_ws128\"\n",
       "DATA_DIR = Path(\"../output/experiments\")\n",
       "EXPERIMENT_DIR = DATA_DIR / EXPERIMENT_NAME\n",
       "\n",
       "print(f\"実験ディレクトリ: {EXPERIMENT_DIR}\")\n",
       "print(f\"存在確認: {EXPERIMENT_DIR.exists()}\")"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# センサーデータ読み込み\n",
       "windows_file = EXPERIMENT_DIR / 'preprocessed' / 'train_windows.pkl'\n",
       "if windows_file.exists():\n",
       "    with open(windows_file, 'rb') as f:\n",
       "        windows = pickle.load(f)\n",
       "    print(f\"センサーデータ読み込み完了: {windows.shape}\")\n",
       "else:\n",
       "    print(\"センサーデータファイルが見つかりません\")\n",
       "    windows = None"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# センサー名の定義（18要素）\n",
       "sensor_names = [\n",
       "    # 加速度センサー (3要素)\n",
       "    'acc_x', 'acc_y', 'acc_z',\n",
       "    # 回転センサー (4要素)\n",
       "    'rot_w', 'rot_x', 'rot_y', 'rot_z',\n",
       "    # 温度センサー (5要素)\n",
       "    'thm_1', 'thm_2', 'thm_3', 'thm_4', 'thm_5',\n",
       "    # ワールド座標系加速度 (6要素)\n",
       "    'acc_w_x', 'acc_w_y', 'acc_w_z',\n",
       "    'lin_acc_x', 'lin_acc_y', 'lin_acc_z'\n",
       "]\n",
       "\n",
       "print(f\"センサー名: {sensor_names}\")\n",
       "print(f\"センサー数: {len(sensor_names)}\")"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "def analyze_outliers_by_sensor(windows, sensor_names, threshold=3.0):\n",
       "    \"\"\"センサーごとの外れ値を分析\"\"\"\n",
       "    \n",
       "    results = {}\n",
       "    \n",
       "    for i, sensor_name in enumerate(sensor_names):\n",
       "        # 各センサーのデータを抽出\n",
       "        sensor_data = windows[:, :, i].flatten()\n",
       "        \n",
       "        # 基本統計\n",
       "        mean_val = sensor_data.mean()\n",
       "        std_val = sensor_data.std()\n",
       "        min_val = sensor_data.min()\n",
       "        max_val = sensor_data.max()\n",
       "        \n",
       "        # Z-score法で外れ値を検出\n",
       "        z_scores = np.abs((sensor_data - mean_val) / std_val)\n",
       "        outliers = z_scores > threshold\n",
       "        outlier_count = outliers.sum()\n",
       "        outlier_ratio = outlier_count / len(sensor_data) * 100\n",
       "        \n",
       "        # 外れ値の詳細\n",
       "        outlier_values = sensor_data[outliers]\n",
       "        outlier_z_scores = z_scores[outliers]\n",
       "        \n",
       "        results[sensor_name] = {\n",
       "            'mean': mean_val,\n",
       "            'std': std_val,\n",
       "            'min': min_val,\n",
       "            'max': max_val,\n",
       "            'outlier_count': outlier_count,\n",
       "            'outlier_ratio': outlier_ratio,\n",
       "            'outlier_values': outlier_values,\n",
       "            'outlier_z_scores': outlier_z_scores,\n",
       "            'max_z_score': z_scores.max()\n",
       "        }\n",
       "    \n",
       "    return results\n",
       "\n",
       "# 外れ値分析実行\n",
       "if windows is not None:\n",
       "    outlier_results = analyze_outliers_by_sensor(windows, sensor_names, threshold=3.0)\n",
       "    print(\"外れ値分析完了\")\nelse:\n    "print(\"データが読み込めませんでした\")\n    outlier_results = {}"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# 外れ値サマリー表示\n",
       "if outlier_results:\n",
       "    print(\"📊 センサー別外れ値サマリー\")\n",
       "    print(\"=\"*80)\n",
       "    \n",
       "    # 外れ値の多い順にソート\n",
       "    sorted_sensors = sorted(outlier_results.items(), \n",
       "                           key=lambda x: x[1]['outlier_count'], \n",
       "                           reverse=True)\n",
       "    \n",
       "    for sensor_name, result in sorted_sensors:\n",
       "        print(f\"\\n🔍 {sensor_name}:\")\n",
       "        print(f\"  範囲: [{result['min']:.3f}, {result['max']:.3f}]\")\n",
       "        print(f\"  平均: {result['mean']:.3f}, 標準偏差: {result['std']:.3f}\")\n",
       "        print(f\"  外れ値数: {result['outlier_count']:,} ({result['outlier_ratio']:.2f}%)\")\n",
       "        print(f\"  最大Z-score: {result['max_z_score']:.2f}\")\n",
       "        \n",
       "        if result['outlier_count'] > 0:\n",
       "            print(f\"  外れ値範囲: [{result['outlier_values'].min():.3f}, {result['outlier_values'].max():.3f}]\")\n",
       "            print(f\"  外れ値Z-score範囲: [{result['outlier_z_scores'].min():.2f}, {result['outlier_z_scores'].max():.2f}]\")"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# 外れ値の多いセンサーを可視化\n",
       "if outlier_results:\n",
       "    # 外れ値比率の高いセンサー上位10個\n",
       "    top_outliers = sorted(outlier_results.items(), \n",
       "                         key=lambda x: x[1]['outlier_ratio'], \n",
       "                         reverse=True)[:10]\n",
       "    \n",
       "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))\n",
       "    \n",
       "    # 外れ値比率\n",
       "    sensor_names_plot = [item[0] for item in top_outliers]\n",
       "    outlier_ratios = [item[1]['outlier_ratio'] for item in top_outliers]\n",
       "    \n",
       "    bars = ax1.bar(range(len(sensor_names_plot)), outlier_ratios, color='red', alpha=0.7)\n",
       "    ax1.set_title('外れ値比率（上位10センサー）')\n",
       "    ax1.set_xlabel('センサー')\n",
       "    ax1.set_ylabel('外れ値比率 (%)')\n",
       "    ax1.set_xticks(range(len(sensor_names_plot)))\n",
       "    ax1.set_xticklabels(sensor_names_plot, rotation=45, ha='right')\n",
       "    \n",
       "    # 最大Z-score\n",
       "    max_z_scores = [item[1]['max_z_score'] for item in top_outliers]\n",
       "    bars2 = ax2.bar(range(len(sensor_names_plot)), max_z_scores, color='orange', alpha=0.7)\n",
       "    ax2.set_title('最大Z-score（上位10センサー）')\n",
       "    ax2.set_xlabel('センサー')\n",
       "    ax2.set_ylabel('最大Z-score')\n",
       "    ax2.set_xticks(range(len(sensor_names_plot)))\n",
       "    ax2.set_xticklabels(sensor_names_plot, rotation=45, ha='right')\n",
       "    \n",
       "    plt.tight_layout()\n",
       "    plt.show()"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# センサー別の分布と外れ値を可視化\n",
       "if outlier_results:\n",
       "    # 外れ値の多いセンサー上位5個を詳細分析\n",
       "    top_5_sensors = sorted(outlier_results.items(), \n",
       "                          key=lambda x: x[1]['outlier_count'], \n",
       "                          reverse=True)[:5]\n",
       "    \n",
       "    fig, axes = plt.subplots(2, 3, figsize=(18, 12))\n",
       "    fig.suptitle('センサー別分布と外れ値分析（上位5センサー）', fontsize=16)\n",
       "    \n",
       "    for idx, (sensor_name, result) in enumerate(top_5_sensors):\n",
       "        if idx >= 5:\n",
       "            break\n",
       "            \n",
       "        row = idx // 3\n",
       "        col = idx % 3\n",
       "        ax = axes[row, col]\n",
       "        \n",
       "        # センサーデータを抽出\n",
       "        sensor_idx = sensor_names.index(sensor_name)\n",
       "        sensor_data = windows[:, :, sensor_idx].flatten()\n",
       "        \n",
       "        # ヒストグラム\n",
       "        ax.hist(sensor_data, bins=50, alpha=0.7, color='blue', density=True)\n",
       "        \n",
       "        # 外れ値を赤で表示\n",
       "        if result['outlier_count'] > 0:\n",
       "            ax.hist(result['outlier_values'], bins=20, alpha=0.8, \n",
       "                   color='red', density=True, label=f'外れ値 ({result[\"outlier_ratio\"]:.1f}%)')\n",
       "        \n",
       "        # 正規分布の理論曲線\n",
       "        x = np.linspace(sensor_data.min(), sensor_data.max(), 100)\n",
       "        normal_dist = (1 / (result['std'] * np.sqrt(2 * np.pi))) * \\\n",
       "                      np.exp(-0.5 * ((x - result['mean']) / result['std']) ** 2)\n",
       "        ax.plot(x, normal_dist, 'g-', linewidth=2, label='正規分布')\n",
       "        \n",
       "        ax.set_title(f'{sensor_name}\\n外れ値: {result[\"outlier_count\"]:,}個 ({result[\"outlier_ratio\"]:.1f}%)')\n",
       "        ax.set_xlabel('値')\n",
       "        ax.set_ylabel('密度')\n",
       "        ax.legend()\n",
       "    \n",
       "    # 6番目のプロットは空にする\n",
       "    axes[1, 2].axis('off')\n",
       "    \n",
       "    plt.tight_layout()\n",
       "    plt.show()"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# センサータイプ別の外れ値分析\n",
       "if outlier_results:\n",
       "    # センサータイプの分類\n",
       "    sensor_types = {\n",
       "        'Accelerometer': ['acc_x', 'acc_y', 'acc_z'],\n",
       "        'Rotation': ['rot_w', 'rot_x', 'rot_y', 'rot_z'],\n",
       "        'Thermal': ['thm_1', 'thm_2', 'thm_3', 'thm_4', 'thm_5'],\n",
       "        'World_Acc': ['acc_w_x', 'acc_w_y', 'acc_w_z'],\n",
       "        'Linear_Acc': ['lin_acc_x', 'lin_acc_y', 'lin_acc_z']\n",
       "    }\n",
       "    \n",
       "    print(\"📊 センサータイプ別外れ値分析\")\n",
       "    print(\"=\"*60)\n",
       "    \n",
       "    type_summary = {}\n",
       "    \n",
       "    for sensor_type, sensors in sensor_types.items():\n",
       "        type_outliers = []\n",
       "        type_ratios = []\n",
       "        \n",
       "        for sensor in sensors:\n",
       "            if sensor in outlier_results:\n",
       "                type_outliers.append(outlier_results[sensor]['outlier_count'])\n",
       "                type_ratios.append(outlier_results[sensor]['outlier_ratio'])\n",
       "        \n",
       "        if type_outliers:\n",
       "            total_outliers = sum(type_outliers)\n",
       "            avg_ratio = np.mean(type_ratios)\n",
       "            max_ratio = max(type_ratios)\n",
       "            \n",
       "            type_summary[sensor_type] = {\n",
       "                'total_outliers': total_outliers,\n",
       "                'avg_ratio': avg_ratio,\n",
       "                'max_ratio': max_ratio,\n",
       "                'sensor_count': len(sensors)\n",
       "            }\n",
       "            \n",
       "            print(f\"\\n🔍 {sensor_type}:\")\n",
       "            print(f\"  センサー数: {len(sensors)}\")\n",
       "            print(f\"  総外れ値数: {total_outliers:,}\")\n",
       "            print(f\"  平均外れ値比率: {avg_ratio:.2f}%\")\n",
       "            print(f\"  最大外れ値比率: {max_ratio:.2f}%\")\n",
       "            \n",
       "            # 個別センサーの詳細\n",
       "            for sensor in sensors:\n",
       "                if sensor in outlier_results:\n",
       "                    result = outlier_results[sensor]\n",
       "                    print(f\"    {sensor}: {result['outlier_count']:,}個 ({result['outlier_ratio']:.2f}%)\")"
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "# センサータイプ別の可視化\n",
