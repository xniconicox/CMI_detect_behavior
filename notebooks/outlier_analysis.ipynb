      "source": [
       "# 外れ値の詳細レポート生成\n",
       "if outlier_results:\n",
       "    print(\"📋 外れ値詳細レポート\")\n",
       "    print(\"=\"*60)\n",
       "    \n",
       "    # 外れ値の多い順にソート\n",
       "    sorted_results = sorted(outlier_results.items(), \n",
       "                           key=lambda x: x[1]['outlier_count'], \n",
       "                           reverse=True)\n",
       "    \n",
       "    print(f\"\\n🔍 外れ値ランキング（上位10センサー）:\")\n",
       "    for i, (sensor_name, result) in enumerate(sorted_results[:10]):\n",
       "        print(f\"{i+1:2d}. {sensor_name:12s}: {result['outlier_count']:8,}個 ({result['outlier_ratio']:5.2f}%)\")\n",
       "    \n",
       "    # 全体統計\n",
       "    total_outliers = sum(result['outlier_count'] for result in outlier_results.values())\n",
       "    total_data_points = windows.size\n",
       "    overall_outlier_ratio = total_outliers / total_data_points * 100\n",
       "    \n",
       "    print(f\"\\n📊 全体統計:\")\n",
       "    print(f\"総データポイント数: {total_data_points:,}\")\n",
       "    print(f\"総外れ値数: {total_outliers:,}\")\n",
       "    print(f\"全体外れ値比率: {overall_outlier_ratio:.3f}%\")\n",
       "    \n",
       "    # 外れ値の多いセンサータイプ\n",
       "    sensor_types = {\n",
       "        'Accelerometer': ['acc_x', 'acc_y', 'acc_z'],\n",
       "        'Rotation': ['rot_w', 'rot_x', 'rot_y', 'rot_z'],\n",
       "        'Thermal': ['thm_1', 'thm_2', 'thm_3', 'thm_4', 'thm_5'],\n",
       "        'World_Acc': ['acc_w_x', 'acc_w_y', 'acc_w_z'],\n",
       "        'Linear_Acc': ['lin_acc_x', 'lin_acc_y', 'lin_acc_z']\n",
       "    }\n",
       "    \n",
       "    print(f\"\\n📊 センサータイプ別外れ値統計:\")\n",
       "    for sensor_type, sensors in sensor_types.items():\n",
       "        type_outliers = sum(outlier_results[sensor]['outlier_count'] \n",
       "                           for sensor in sensors if sensor in outlier_results)\n",
       "        type_ratios = [outlier_results[sensor]['outlier_ratio'] \n",
       "                      for sensor in sensors if sensor in outlier_results]\n",
       "        avg_ratio = np.mean(type_ratios) if type_ratios else 0\n",
       "        \n",
       "        print(f\"{sensor_type:15s}: {type_outliers:8,}個 (平均{avg_ratio:5.2f}%)\")\n",
       "    \n",
       "    print(f\"\\n✅ 分析完了！\")"
      ]
     }
